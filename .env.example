# Application Settings
APP_NAME="StockFlow API"
APP_ENV="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL + asyncpg)
POSTGRES_USER="stockflow"
POSTGRES_PASSWORD="stockflow_secret_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="stockflow_db"
DATABASE_URL="postgresql+asyncpg://stockflow:stockflow_secret_password@localhost:5433/stockflow_db"

# Security & JWT Settings
SECRET_KEY="change-this-super-secret-jwt-key-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Concurrency & Idempotency Settings
DB_LOCK_TIMEOUT_MS=5000
IDEMPOTENCY_TTL_HOURS=24
